rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(storyId) 
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn() && isValidId(storyId) && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if isSignedIn() && isValidId(storyId) && resource.data.authorId == request.auth.uid;
    }

    // Friend Requests Collection
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(requestId)
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(requestId) && (
        resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(requestId) && (
        resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid
      );
    }

    // Direct Messages Collection
    match /direct_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(messageId)
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(messageId) && (
        (resource.data.recipientId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(messageId) && resource.data.senderId == request.auth.uid;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(notificationId) && resource.data.userId == request.auth.uid;
    }
  }
}
